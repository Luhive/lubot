# Public — safe to expose to the browser (used by Supabase client)
NEXT_PUBLIC_SUPABASE_URL=''
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=''
NEXT_PUBLIC_APP_URL='http://localhost:3000'

# Server-only secrets — never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=''
OPENAI_API_KEY=''
TELEGRAM_BOT_TOKEN=''

# Set to 'true' to enable the login wall and auth redirects (production mode)
AUTH_ENABLED=false
