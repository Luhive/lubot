# Public — safe to expose to the browser (used by Supabase client)
NEXT_PUBLIC_SUPABASE_URL=''
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=''

# Server-only secrets — never exposed to the browser
